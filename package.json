{
  "name": "velozix-bits",
  "version": "0.1.5",
  "type": "module",
  "description": "High-velocity 60FPS animated React & Next.js UI bits and components",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./index.css": "./dist/index.css",
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "react",
    "nextjs",
    "ui",
    "components",
    "animations",
    "gsap",
    "lenis",
    "motion",
    "adaptive-ui"
  ],
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build:app": "next build",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/style.css --minify",
    "build:lib": "tsup && npm run build:css",
    "build": "npm run build:lib && next build",
    "start": "next start",
    "lint": "eslint",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@types/three": "^0.187.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "shadcn": "^4.23.0",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  }
}
